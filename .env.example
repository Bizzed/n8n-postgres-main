# ═════════════════════════════════════════════════════════════════════════════
# n8n-postgres-main — Railway Environment Variables
#
# Copy these into your Railway service's Variables tab.
# NEVER commit real values to this file — it is documentation only.
#
# Railway variable reference syntax (${{Service.VAR}}) is used for anything
# that comes from a linked Railway plugin (e.g. Postgres). Railway resolves
# these at deploy time.
# ═════════════════════════════════════════════════════════════════════════════


# ── Database ──────────────────────────────────────────────────────────────────
# Add a Postgres plugin to your Railway project, then Railway auto-populates
# these variables. Use the reference syntax below so they stay in sync.

DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=${{Postgres.PGHOST}}
DB_POSTGRESDB_PORT=${{Postgres.PGPORT}}
DB_POSTGRESDB_DATABASE=${{Postgres.PGDATABASE}}
DB_POSTGRESDB_USER=${{Postgres.PGUSER}}
DB_POSTGRESDB_PASSWORD=${{Postgres.PGPASSWORD}}

# Railway Postgres requires SSL. Keep this true.
DB_POSTGRESDB_SSL_ENABLED=true

# Bump pool size if you see connection bottlenecks under load.
DB_POSTGRESDB_POOL_SIZE=5


# ── Host & Networking ─────────────────────────────────────────────────────────
# Replace with your Railway-generated domain, or a custom domain if configured.
# WEBHOOK_URL must be reachable from the internet for triggers to work.

N8N_HOST=your-service.up.railway.app
N8N_PORT=5678
N8N_PROTOCOL=https
WEBHOOK_URL=https://your-service.up.railway.app/


# ── Execution Mode ────────────────────────────────────────────────────────────
# 'regular' = single-process mode. No Redis. No workers. This is intentional.
# Do NOT change to 'queue' unless you are also adding Redis and worker services.

EXECUTIONS_MODE=regular


# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
#
# N8N_ENCRYPTION_KEY protects all stored credentials. Once set and workflows
# are running, DO NOT change this value — it will break all stored credentials.
#
# N8N_USER_MANAGEMENT_JWT_SECRET signs user session tokens. Rotating it logs
# out all active users but is otherwise safe.

N8N_ENCRYPTION_KEY=
N8N_USER_MANAGEMENT_JWT_SECRET=


# ── Timezone ──────────────────────────────────────────────────────────────────
# Sets the default timezone for cron-based workflow triggers.
# Overrides the value in config/production.json if set here.
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones

GENERIC_TIMEZONE=America/New_York


# ── Telemetry (opt-out) ───────────────────────────────────────────────────────
# Disables n8n's anonymous usage diagnostics. Already set in production.json
# but repeated here in case the config file is not loaded.

N8N_DIAGNOSTICS_ENABLED=false


# ── Custom nodes (optional) ───────────────────────────────────────────────────
# If you install custom node packages via the Dockerfile, they are discovered
# automatically from node_modules. Only set this if loading nodes from a path
# outside node_modules (e.g. locally copied packages during development).

# N8N_CUSTOM_EXTENSIONS=/home/node/.n8n/custom


# ── SMTP / email (optional) ───────────────────────────────────────────────────
# Required if you want n8n to send invite emails or password reset links.
# Without SMTP, invite links are still generated — just copy/paste manually.

# N8N_EMAIL_MODE=smtp
# N8N_SMTP_HOST=smtp.example.com
# N8N_SMTP_PORT=465
# N8N_SMTP_SSL=true
# N8N_SMTP_USER=
# N8N_SMTP_PASS=
# N8N_SMTP_SENDER=n8n@example.com
